{
  "version": 2,
  "functions": {
    "api/dica.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/apostila-reta-final-gcm-paracatu.html",
      "destination": "/apostila-reta-final-gcm-paracatu-direto.html"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
